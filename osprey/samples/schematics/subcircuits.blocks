# Common subcircuits, each one block, for learning how a person draws them.
# Generate my layout with:
#   npm run osprey -- generate samples/schematics/subcircuits.blocks -o samples/schematics/subcircuits-gen.osprey
# subcircuits-hand.osprey starts as a copy of -gen and is redrawn by hand; it is never regenerated.
# Blocks share only VCC and GND; every other net stays inside its block.

design subcircuits
use ../osprey/madhu.ospreylib
use ../osprey/wwvbfind2.osprey          # for the supply2 symbols

supply VCC supply2/VCC
supply GND supply2/GND

# Voltage divider: halves VCC, with a filter capacitor on the output, to a connector.
block Divider
R1     madhu/RESISTOR       10k   0805-RES
R2     madhu/RESISTOR       10k   0805-RES
C1     madhu/CAPACITOR-NP   100n  0805
J1     madhu/BERG-2
VCC: R1.2
net: R1.1 R2.2 C1.1 J1.2
GND: R2.1 C1.2 J1.1

# RC low-pass: input connector, series R, shunt C, output connector.
block RC-lowpass
IN1    madhu/BERG-2
R3     madhu/RESISTOR       1k    0805-RES
C2     madhu/CAPACITOR-NP   100n  0805
OUT1   madhu/BERG-2
net: IN1.2 R3.1
net: R3.2 C2.1 OUT1.2
GND: IN1.1 C2.2 OUT1.1

# LED on the supply: series resistor from VCC, LED to ground.
block LED
R4     madhu/RESISTOR       1k    0805-RES
D1     madhu/LED            0805
VCC: R4.2
net: R4.1 D1.A
GND: D1.C

# Common-emitter amplifier: input coupling cap, divider bias, collector and emitter
# resistors, emitter bypass cap, output coupling cap.
block CE-amp
IN2    madhu/BERG-2
C3     madhu/CAPACITOR-NP   1u    0805
R5     madhu/RESISTOR       47k   0805-RES
R6     madhu/RESISTOR       10k   0805-RES
Q1     madhu/MMBT3904
R7     madhu/RESISTOR       4.7k  0805-RES
R8     madhu/RESISTOR       1k    0805-RES
C4     madhu/CAPACITOR-NP   10u   0805
C5     madhu/CAPACITOR-NP   1u    0805
OUT2   madhu/BERG-2
net: IN2.2 C3.1
net: C3.2 R5.1 R6.2 Q1.B
VCC: R5.2 R7.2
net: Q1.C R7.1 C5.1
net: Q1.E R8.2 C4.1
GND: IN2.1 R6.1 R8.1 C4.2 OUT2.1
net: C5.2 OUT2.2

# Inverting op-amp amplifier on a single supply: input resistor to -IN, feedback resistor
# from OUT to -IN, +IN biased at half supply by a divider with a capacitor, a bypass cap.
block Inverting-amp
IN3    madhu/BERG-2
R9     madhu/RESISTOR       10k   0805-RES
U1     madhu/MCP6001
R10    madhu/RESISTOR       100k  0805-RES
R11    madhu/RESISTOR       100k  0805-RES
R12    madhu/RESISTOR       100k  0805-RES
C6     madhu/CAPACITOR-NP   1u    0805
C7     madhu/CAPACITOR-NP   100n  0805
OUT3   madhu/BERG-2
net: IN3.2 R9.1
net: R9.2 U1.-IN R10.1
net: U1.OUT R10.2 OUT3.2
net: U1.+IN R11.1 R12.2 C6.1
VCC: U1.V+ R11.2 C7.1
GND: U1.V- R12.1 C6.2 C7.2 IN3.1 OUT3.1

# Tuned amplifier: a transistor stage with an LC tank in the collector, fed from VCC,
# divider bias on the base, bypassed emitter resistor, output coupled from the collector.
block LC-tank
IN4    madhu/BERG-2
C8     madhu/CAPACITOR-NP   10n   0805
R13    madhu/RESISTOR       47k   0805-RES
R14    madhu/RESISTOR       10k   0805-RES
Q2     madhu/MMBT3904
L1     madhu/INDUCTOR-VAR2
C9     madhu/CAPACITOR-NP   1.5n  0805
R15    madhu/RESISTOR       1k    0805-RES
C10    madhu/CAPACITOR-NP   10u   0805
C11    madhu/CAPACITOR-NP   10n   0805
OUT4   madhu/BERG-2
net: IN4.2 C8.1
net: C8.2 R13.1 R14.2 Q2.B
VCC: R13.2 L1.E L1.E1 C9.1
net: Q2.C L1.A C9.2 C11.1
net: Q2.E R15.2 C10.1
GND: IN4.1 R14.1 R15.1 C10.2 OUT4.1
net: C11.2 OUT4.2

# ATtiny412 with its decoupling cap, a UPDI programming header, a trimmer on an ADC pin and an LED on an output pin.
# From panels/ATTiny412.
block ATtiny412
C12    madhu/CAPACITOR-NP    0.1u    0805
U2     madhu/ATTINY412
R17    madhu/RESISTOR        1k      0805-RES
D2     madhu/LED             LED0805 0805
R16    madhu/TRIMPOT                 -10T
C13    madhu/CAPACITOR-NP    0.1u    0805
P1     madhu/BERG-3
VCC: C12.1 U2.VDD R16.CW P1.3
GND: C12.2 U2.GND R16.CCW D2.C C13.2 P1.2
net: U2.PA1 R17.2
net: R17.1 D2.A
net: U2.PA3/EXTCLK R16.CT C13.1
net UPDI: U2.PA0/!RESET!/UPDI P1.1
nc: U2.PA6 U2.PA7 U2.PA2

# Crystal with two load capacitors to ground, for an MCU's XTAL pins.
# From ustem/atmega8u2.
block Crystal
X1     madhu/CRYSTAL         16MHz   HC49U-V
C14    madhu/CAPACITOR-NP    18p     0.2"
C15    madhu/CAPACITOR-NP    18p     0.2"
GND: C14.1 C15.1
net: C14.2 X1.2
net: C15.2 X1.1

# Reset pull-up to the supply with a push button to ground.
# From ustem/atmega8u2.
block Reset-button
S1     madhu/PCB-SWITCH      S
R18    madhu/RESISTOR        10k     1206
GND: S1.P1 S1.P
VCC: R18.2
net RESET: R18.1 S1.S1 S1.S

# 78L05 regulator: input connector through a series diode (reverse polarity), caps on input and output.
# From ustem/tiny24X.
block Regulator
U3     madhu/78L05                   AP
J2     madhu/HEADER-2                0.1
D4     madhu/1N914                   V
C16    madhu/CAPACITOR-NP    0.1u    1206
C17    madhu/CAPACITOR-NP    0.1u    1206
GND: U3.GND C17.2 J2.1 C16.2
VCC: U3.VO C17.1
net: J2.2 D4.A
net: U3.VI D4.C C16.1

# MAX17225 boost converter: inductor, input and output caps, output-select resistor, enable pull-up, in and out connectors.
# From IoT/nano-boost_rev_C.
block Boost
U4     madhu/MAX17225                ELT
J3     madhu/BERG-2
J4     madhu/BERG-2
R19    madhu/RESISTOR        80.6k   1206
L2     madhu/INDUCTOR        2.2u    -XFL4020
C18    madhu/CAPACITOR-NP    10u     1206
C19    madhu/CAPACITOR-NP    10u     1206
R20    madhu/RESISTOR        33M     1206
net: U4.OUT J4.2 C19.1
net: U4.LX L2.2
net: R19.2 U4.SEL
net: U4.EN R20.1
GND: J3.1 U4.GND J4.1 R19.1 C18.2 C19.2
VCC: J3.2 U4.IN L2.1 C18.1 R20.2

# Reverse-polarity protection: P-MOSFET with its gate to ground, drain from the input, source to the output, caps on both sides.
# From ustem/Polarity.
block PMOS-polarity
VIN    madhu/BERG-2
C20    madhu/CAPACITOR-NP    0.1u    0805
Q3     madhu/DMG2305UX
C21    madhu/CAPACITOR-NP    0.1u    0805
VOUT   madhu/BERG-2
GND: VIN.1 C20.2 Q3.G C21.2 VOUT.1
net: VIN.2 C20.1 Q3.D
net: VOUT.2 Q3.S C21.1

# Low-side N-MOSFET switch driving an off-board load from the supply, with a flyback diode across the load.
# From BeamSensor/beamsensor.
block MOSFET-switch
Q4     madhu/2N7000
D3     madhu/1N4001                  V
OUT    madhu/BERG-2
GND: Q4.S
VCC: D3.C OUT.2
net: D3.A Q4.D OUT.1
nc: Q4.G

# 555 astable, its timing R and C plugged into headers, reset pulled up, control pin bypassed.
# From ustem/555-astable.
block 555-astable
PWR    madhu/BERG-2
U5     madhu/NE555                   D
C22    madhu/CAPACITOR-NP    0.1u    0805
J5     madhu/HEADER-2                0.1
J6     madhu/HEADER-2                0.1
R21    madhu/RESISTOR        10k     0805-RES
R22    madhu/RESISTOR        1k      0805-RES
C23    madhu/CAPACITOR-NP    0.1u    0805
J7     madhu/TP-1
GND: PWR.1 U5.GND C22.2 J5.1 C23.2
net: U5.TRE U5.TRI J5.2 R22.2
net: U5.CON C22.1
VCC: U5.VCC PWR.2 R21.2 C23.1
net: U5.OUT J6.1
net: U5./RES R21.1 J7.1
net: J6.2 R22.1
nc: U5.DIS

# NPN current mirror in a dual transistor, reference resistor and output to connectors.
# From ustem/n-mirror.
block Current-mirror
P2     madhu/BERG-2
R23    madhu/RESISTOR                0805-RES
P3     madhu/BERG-2
Q5     madhu/MBT3904DW1T1G           -1
net: P3.1 R23.2
net: P3.2 Q5.A.C
net: R23.1 Q5.B.C Q5.B.B Q5.A.B
GND: P2.1 Q5.B.E Q5.A.E
nc: P2.2

# Differential pair with an NPN current-mirror tail and a PNP mirror load (a mixer).
# From ustem/mixer.
block Diff-pair
P4     madhu/BERG-2
R24    madhu/RESISTOR                0805-RES
Q6     madhu/MBT3904DW1T1G           -1
Q7     madhu/MBT3904DW1T1G           -1
Q8     madhu/BCV62
P5     madhu/BERG-4                  TH
R25    madhu/RESISTOR                0805-RES
R26    madhu/RESISTOR                0805-RES
P6     madhu/BERG-2
C24    madhu/CAPACITOR-NP            0805
C25    madhu/CAPACITOR-NP            0805
net: R24.1 Q6.B.C Q6.B.B Q6.A.B
GND: P4.1 Q6.B.E Q6.A.E R26.1 P6.1 C25.2
net: Q8.C2 Q7.A.C P5.2
net: Q7.A.E Q7.B.E Q6.A.C
net: Q7.B.C Q8.C1 P5.3
net: Q8.E1 P4.2 Q8.E2 R25.2 C25.1
net: R26.2 R25.1 Q7.A.B C24.2
net: R24.2 P5.1
net: P6.2 C24.1
net: P5.4 Q7.B.B

# Colpitts oscillator, common collector: capacitive divider base-emitter-ground, tuned inductor on the base, output divider from the emitter.
# From ustem/3904Colpitts4.
block Colpitts
P7     madhu/BERG-2
C26    madhu/CAPACITOR-NP    0.1u    0805
C27    madhu/CAPACITOR-NP    0.1u    0805
P8     madhu/BERG-2
Q9     madhu/MMBT3904                L
R27    madhu/RESISTOR        100     0805-RES
R28    madhu/RESISTOR        10k     0805-RES
R29    madhu/RESISTOR        100     0805-RES
C28    madhu/CAPACITOR-NP    0.1u    0805
R30    madhu/RESISTOR        10k     0805-RES
L3     madhu/INDUCTOR-VAR            -T1028
C29    madhu/CAPACITOR-NP    3300p   0805
C30    madhu/CAPACITOR-NP    3300p   0805
L4     madhu/INDUCTOR-VAR            -HOSFELT
GND: C27.2 P8.1 P7.1 R29.2 C30.2 L3.E L4.E
VCC: C27.1 R27.1 R28.1 Q9.C
net: P7.2 C26.1
net: Q9.B R28.2 C29.1 C28.1
net: P8.2 R27.2
net: Q9.E R30.2 C29.2 C30.1
net: R30.1 R29.1 C26.2
net: L3.A C28.2 L4.A

# Colpitts oscillator, common base, with an emitter-follower buffer and a diode detector.
# From ustem/3904Colpitts1.
block Colpitts-CB
P9     madhu/BERG-2
C31    madhu/CAPACITOR-NP    0.1u    0805
C32    madhu/CAPACITOR-NP    0.1u    0805
P10    madhu/BERG-2
Q10    madhu/MMBT3904                L
Q11    madhu/MMBT3904                L
L5     madhu/INDUCTOR-VAR            -HOSFELT
R31    madhu/RESISTOR        100     0805-RES
R32    madhu/RESISTOR        10k     0805-RES
R33    madhu/RESISTOR        10k     0805-RES
R34    madhu/RESISTOR        2.2k    0805-RES
C33    madhu/CAPACITOR-NP    0.1u    0805
C34    madhu/CAPACITOR-NP    22p     0805
C35    madhu/CAPACITOR-NP    22p     0805
R35    madhu/RESISTOR        10k     0805-RES
R36    madhu/RESISTOR        100     0805-RES
C36    madhu/CAPACITOR-NP    0.1u    0805
C37    madhu/CAPACITOR-NP    0.1u    0805
D5     madhu/LS4148
R37    madhu/RESISTOR        10k     0805-RES
FM     madhu/BERG-2
GND: C32.2 P10.1 P9.1 R33.2 R34.2 C33.2 C35.2 D5.A FM.1 R36.2
VCC: C32.1 R31.1 L5.A R32.1 Q11.C
net: P9.2 C31.1
net: Q10.C L5.E Q11.B C34.1
net: Q10.B R32.2 R33.1 C33.1
net: Q10.E R34.1 C34.2 C35.1 C37.1
net: P10.2 R31.2
net: Q11.E R35.1 C36.1
net: C31.2 R35.2 R36.1 C36.2
net: C37.2 D5.C R37.2
net: FM.2 R37.1

# Two-transistor multivibrator with LEDs in the collectors and push buttons.
# From ustem/t2.
block Multivibrator
S2     madhu/PCB-SWITCH
S3     madhu/PCB-SWITCH
R38    madhu/RESISTOR        1k      VERTICAL-0.1
R39    madhu/RESISTOR        10k     VERTICAL-0.1
R40    madhu/RESISTOR        100k    VERTICAL-0.1
R41    madhu/RESISTOR        100k    VERTICAL-0.1
R42    madhu/RESISTOR        10k     VERTICAL-0.1
R43    madhu/RESISTOR        1k      VERTICAL-0.1
D6     madhu/LED                     3MM
D7     madhu/LED                     3MM
C38    madhu/CAPACITOR-NP    0.47u   0.1"
C39    madhu/CAPACITOR-NP    0.47u   0.1"
Q12    madhu/2N3904          2N3904
Q13    madhu/2N3904          2N3904
J8     madhu/TEST-POINT
GND1   madhu/TEST-POINT
C40    madhu/CAPACITOR-NP    0.1u    1206
C41    madhu/CAPACITOR-NP    0.1u    1206
P11    madhu/TEST-POINT
P12    madhu/TEST-POINT
net: R38.1 D7.A
net: D7.C R39.1 Q13.C C38.1 S2.S1 C40.2
net: R43.1 D6.A
net: R42.1 Q12.C D6.C C39.2 S3.S C41.1
net: C38.2 R40.1 Q12.B
net: R41.1 C39.1 Q13.B
GND: Q12.E Q13.E S2.P1 S3.P GND1.1
VCC: R38.2 R43.2 R42.2 R41.2 R40.2 R39.2 J8.1
net: P11.1 C40.1
net: C41.2 P12.1
nc: S2.P S2.S S3.P1 S3.S1

# Power latch: an NPN turns on a PNP high-side switch; a second NPN turns it off.
# From IoT/RTC_latch.
block Power-latch
Q14    madhu/MMBT3904                L
Q15    madhu/MMBT3906                L
R44    madhu/RESISTOR                1206
R45    madhu/RESISTOR                1206
R46    madhu/RESISTOR                1206
R47    madhu/RESISTOR                1206
C42    madhu/CAPACITOR-NP            0.2"
Q16    madhu/MMBT3904                L
R48    madhu/RESISTOR                1206
R49    madhu/RESISTOR                1206
PWR_OFF madhu/TP-1
PWR_EN madhu/TP-1
net: R44.1 R46.2 Q15.B
net: R46.1 Q14.C
net: R47.1 R45.2 Q14.B
net BOOST_EN: Q15.C R47.2 C42.2 Q16.C PWR_EN.1
net: Q16.B R49.2 R48.2
GND: Q14.E R45.1 Q16.E R48.1
VCC: R44.2 Q15.E C42.1
net: PWR_OFF.1 R49.1

# Diode peak detector with an op-amp follower buffer to an output connector.
# From ustem/PNP-Dipper.
block Detector-buffer
C44    madhu/CAPACITOR-NP    0.1u    0805
VOUT1  madhu/BERG-2
U6     madhu/MCP6001                 -SOT23-5
D8     madhu/1N914                   H
C43    madhu/CAPACITOR-NP    0.1u    0805
R50    madhu/RESISTOR        1M      0805-RES
GND: C44.2 U6.V- C43.2 R50.1 VOUT1.1
VCC: C44.1 U6.V+
net: R50.2 D8.C C43.1 U6.+IN
net: U6.-IN U6.OUT VOUT1.2
nc: D8.A
