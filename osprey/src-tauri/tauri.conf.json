{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Osprey",
  "version": "0.1.0",
  "identifier": "com.madhu.osprey",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Osprey",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "osprey"
        ],
        "name": "Osprey project",
        "description": "Osprey project",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "shortDescription": "Electronic CAD: schematics, boards, CAM",
    "publisher": "Madhu Siddalingaiah"
  }
}
