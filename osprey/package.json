{
  "name": "osprey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based electronic CAD built around noun-verb editing",
  "bin": {
    "osprey": "scripts/osprey.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "drive": "node scripts/drive.mjs",
    "osprey": "node scripts/osprey.mjs",
    "samples": "vitest run test/samples.test.ts -u",
    "app": "npm run build && vite preview --port 4173 --strictPort --open",
    "icons": "node scripts/build-icons.mjs",
    "tauri": "tauri",
    "native": "tauri build",
    "native:dev": "tauri dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "clipper2-js": "1.2.4"
  }
}
