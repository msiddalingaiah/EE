{
  "name": "osprey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based electronic CAD built around noun-verb editing",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "vitest run test/samples.test.ts -u",
    "app": "npm run build && vite preview --port 4173 --strictPort --open",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "clipper2-js": "1.2.4"
  }
}
